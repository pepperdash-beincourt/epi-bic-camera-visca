<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ProjectType>ProgramLibrary</ProjectType>
	</PropertyGroup>
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<RootNamespace>PepperDash.Essentials.Plugins.ViscaCamera</RootNamespace>
		<Deterministic>false</Deterministic>
		<AssemblyTitle>PepperDash.Essentials.Plugins.ViscaCamera</AssemblyTitle>
		<Company>PepperDash Technologies</Company>
		<Description>This software is a PepperDash Essentials Plugin for the Nanolumens H-Series.</Description>
		<Copyright>Copyright 2025</Copyright>
		<Version>1.0.0-local</Version>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<InformationalVersion>$(Version)</InformationalVersion>
		<OutputPath>4Series\bin\$(Configuration)\</OutputPath>
		<Authors>PepperDash Technologies</Authors>
		<PackageId>Pepperdash.Essentials.Plugins.ViscaCamera</PackageId>
		<PackageProjectUrl>https://github.com/PepperDash/epi-visca-camera.git</PackageProjectUrl>
		<PackageTags>crestron 4series essentials plugin</PackageTags>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants);SERIES4</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Properties\**" />
		<EmbeddedResource Remove="Properties\**" />
		<None Remove="Properties\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="epi-visca-camera.projectinfo" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="../output\epi-visca-camera.4Series.1.0.0-local.cplz" />
	</ItemGroup>

	
	
	

	<ItemGroup>
		<PackageReference Include="PepperDashEssentials" Version="2.7.3">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>